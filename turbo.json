{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "*.tsbuildinfo"],
      "env": [
        "PRODUCT_MODE",
        "NEXT_PUBLIC_PRODUCT_MODE",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_MODE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_ENABLE_DEVELOPER_DIAGNOSTICS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "PRODUCT_MODE",
        "NEXT_PUBLIC_PRODUCT_MODE",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_MODE",
        "NEXT_PUBLIC_ENABLE_DEVELOPER_DIAGNOSTICS"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
